@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT TARGET RealScript::SlimRuntime)
    if(NOT RealScript_DIR AND NOT "@REALSCRIPT_CONFIG_HINT_DIR@" STREQUAL "" AND EXISTS "@REALSCRIPT_CONFIG_HINT_DIR@/RealScriptConfig.cmake")
        set(RealScript_DIR "@REALSCRIPT_CONFIG_HINT_DIR@")
    endif()
    find_dependency(RealScript CONFIG)
endif()

if(NOT TARGET RealScript::GameRuntime)
    include("${CMAKE_CURRENT_LIST_DIR}/RealScriptGamePackTargets.cmake")
endif()

set(RealScriptGamePack_VERSION "@PROJECT_VERSION@")
check_required_components(RealScriptGamePack)
